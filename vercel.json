{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/delete",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/account-deletion",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/data-deletion",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/policies/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/pages/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/pages/delete-account",
      "destination": "/delete-account",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
